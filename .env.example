# Interoperability Gateway Environment Configuration

# Application Settings
APP_NAME=InteropGateway
APP_ENV=development
REGION=india
SECRET_KEY=generate-a-secure-secret-key-here
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
API_KEY_HEADER=X-Gateway-API-Key
HMAC_SECRET_KEY=your-hmac-shared-secret
OAUTH2_JWT_SECRET=your-jwt-signing-secret
REQUIRE_AUTHORIZATION_HEADER=true
ENFORCE_REGION_HEADER=true
SECURITY_ENFORCED_PREFIX=/api/v1
ALLOWED_SOURCE_IPS=
REQUIRE_JWT_VALIDATION=true
JWT_SECRET=
JWT_PUBLIC_KEY_PEM=
JWT_EXPECTED_ISSUER=
JWT_EXPECTED_AUDIENCE=

# Integration Resolver
ENABLE_ABHA=true
ENABLE_NABIDH=false
ENABLED_NETWORKS=ABHA,NABIDH
REGION_NETWORK_MAP=india:ABHA,uae:NABIDH,uk:NHS_SPINE,australia:MY_HEALTH_RECORD,usa:EHEALTH_EXCHANGE,canada:CANADA_HEALTH_INFOWAY,singapore:NEHR,finland:KANTA,denmark:DANISH_NHDN

# Client SSL / mTLS
TLS_ENABLED=false
TLS_CERT_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem

# Integration Configuration
CONFIG_PATH=./app/config/integrations
CONFIG_WATCH_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_AUDIT_ENABLED=true

# Retry Defaults
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_DELAY=1.0
DEFAULT_RETRY_BACKOFF=2.0

# ABDM M1
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_AUTH_PATH=/api/hiecm/gateway/v3/sessions
ABDM_CLIENT_ID= your-client-id-here
ABDM_CLIENT_SECRET= your-client-secret-here
ABDM_GRANT_TYPE=client_credentials
ABDM_CM_ID=sbx
ABDM_PARTICIPANT_ID=
ABDM_PARTICIPANT_TYPE=HIP
ABDM_CALLBACK_BASE_PATH=/abdm/m1/callback
ABDM_CALLBACK_AUTH_MODE=none
ABDM_CALLBACK_HMAC_SECRET=
ABDM_CALLBACK_HMAC_TOLERANCE_SECONDS=300
ABDM_CALLBACK_IP_WHITELIST=
ABDM_HEADER_TIMESTAMP_TOLERANCE_SECONDS=300
ABDM_HTTP_TIMEOUT_SECONDS=15
ABDM_HTTP_RETRY_ATTEMPTS=2
ABDM_TOKEN_REFRESH_SKEW_SECONDS=120
ABDM_ABHA_GENERATE_OTP_PATH=/v1/registration/aadhaar/generateOtp
ABDM_ABHA_VERIFY_OTP_PATH=/v1/registration/aadhaar/verifyOTP
ABDM_ABHA_GENERATE_MOBILE_OTP_PATH=/v1/registration/aadhaar/generateMobileOTP
ABDM_ABHA_VERIFY_MOBILE_OTP_PATH=/v1/registration/aadhaar/verifyMobileOTP
ABDM_ABHA_CREATE_ADDRESS_PATH=/v1/registration/aadhaar/createHealthIdWithPreVerified
ABDM_ABHA_CHANGE_MOBILE_NEW_GENERATE_OTP_PATH=/v2/account/change/mobile/new/generateOTP
ABDM_ABHA_CHANGE_MOBILE_NEW_VERIFY_OTP_PATH=/v2/account/change/mobile/new/verifyOTP
ABDM_ABHA_CHANGE_MOBILE_AADHAAR_GENERATE_OTP_PATH=/v2/account/change/mobile/aadhaar/generateOTP
ABDM_ABHA_CHANGE_MOBILE_OLD_GENERATE_OTP_PATH=/v2/account/change/mobile/old/generateOTP
ABDM_ABHA_CHANGE_MOBILE_UPDATE_AUTH_PATH=/v2/account/change/mobile/update/authentication
ABDM_ABHA_CREATE_NUMBER_PATH=
ABDM_ABHA_AUTO_ADD_CONSENT=true
ABDM_ABHA_CONSENT_CODE=abha-enrollment
ABDM_ABHA_CONSENT_VERSION=1.4
ABDM_ABHA_V3_BASE_URL=https://abhasbx.abdm.gov.in
ABDM_ABHA_V3_PUBLIC_CERT_PATH=/abha/api/v3/profile/public/certificate
ABDM_ABHA_V3_SEARCH_PATH=/abha/api/v3/profile/account/abha/search
ABDM_ABHA_V3_LOGIN_REQUEST_OTP_PATH=/abha/api/v3/profile/login/request/otp
ABDM_ABHA_V3_LOGIN_VERIFY_PATH=/abha/api/v3/profile/login/verify
ABDM_ABHA_V3_ENROLL_REQUEST_OTP_PATH=/abha/api/v3/enrollment/request/otp
ABDM_ABHA_V3_ENROLL_BY_AADHAAR_PATH=/abha/api/v3/enrollment/enrol/byAadhaar
ABDM_ABHA_V3_ENROLL_AUTH_BY_ABDM_PATH=/abha/api/v3/enrollment/auth/byAbdm
ABDM_ABHA_V3_ADDRESS_SUGGESTIONS_PATH=/abha/api/v3/enrollment/enrol/suggestion
ABDM_ABHA_V3_CREATE_PHR_ADDRESS_PATH=/abha/api/v3/enrollment/enrol/abha-address
ABDM_ABHA_V3_ACCOUNT_REQUEST_OTP_PATH=/abha/api/v3/profile/account/request/otp
ABDM_ABHA_V3_ACCOUNT_VERIFY_PATH=/abha/api/v3/profile/account/verify
ABDM_ABHA_V3_ABHA_CARD_PATH=/abha/api/v3/profile/account/abha-card
ABDM_ABHA_V3_ENROL_SUGGESTIONS_GET_PATH=/abha/api/v3/enrollment/enrol/suggestion
ABDM_ABHA_V3_ENROL_PHR_ADDRESS_PATH=/abha/api/v3/enrollment/enrol/phr-address
ABDM_ABHA_V3_ACCOUNT_CARD_PATH=/abha/api/v3/account/card
ABDM_HPR_BASE_URL=https://apihspsbx.abdm.gov.in
ABDM_HPR_API_PREFIX=/v4/int/apis/v1
ABDM_HPR_REGISTRATION_PREFIX=/v4/int/v2
ABDM_HPR_MASTER_DATA_PREFIX=/v4/int/apis/v1
ABDM_HPR_PUBLIC_CERT_PATH=/v4/int/v2/auth/cert

# Deployment lock (set per deployment)
HEALTH_NETWORK=ABHA
ENFORCE_NETWORK_LOCK=true
ABDM_EXPECTED_CLIENT_ID=
ABDM_EXPECTED_BASE_URL=

# ABDM M2 participant identities
ABDM_HIP_ID=your.hip.id
ABDM_HIU_ID=your.hiu.id
ABDM_FACILITY_ID=your.facility.id

# ABDM M2 endpoint paths
ABDM_M2_OPENID_CONFIG_PATH=/api/hiecm/gateway/v3/.well-known/openid-configuration
ABDM_M2_CERTS_PATH=/api/hiecm/gateway/v3/certs
ABDM_M2_BRIDGE_URL_PATH=/api/hiecm/gateway/v3/bridge/url
ABDM_M2_BRIDGE_SERVICE_BY_ID_PATH=/api/hiecm/gateway/v3/bridge-service/serviceId/{serviceId}
ABDM_M2_BRIDGE_SERVICES_PATH=/api/hiecm/gateway/v3/bridge-services
ABDM_M2_BRIDGE_SERVICES_UPDATE_PATH=/v1/bridges/MutipleHRPAddUpdateServices
ABDM_M2_LINK_TOKEN_GENERATE_PATH=/api/hiecm/v3/token/generate-token
ABDM_M2_LINK_CARE_CONTEXT_PATH=/api/hiecm/hip/v3/link/carecontext
ABDM_M2_SESSIONS_PATH=/gateway/v0.5/sessions
ABDM_M2_PATIENT_DISCOVER_PATH=/gateway/v0.5/patients/discover
ABDM_M2_CONSENT_REQUEST_INIT_PATH=/gateway/v0.5/consent-requests/init
ABDM_M2_CONSENT_STATUS_PATH_TEMPLATE=/gateway/v0.5/consents/{consent_id}
ABDM_M2_HEALTH_INFO_REQUEST_PATH=/gateway/v0.5/health-information/cm/request
ABDM_M2_CARE_CONTEXTS_DISCOVER_PATH=/gateway/v0.5/care-contexts/discover
ABDM_M2_CARE_CONTEXTS_LINK_PATH=/gateway/v0.5/links/link/init

# ABDM M3 endpoint paths
ABDM_M3_SESSIONS_PATH=/api/hiecm/gateway/v3/sessions
ABDM_M3_CONSENT_REQUEST_INIT_PATH=/api/hiecm/consent/v3/request/init
ABDM_M3_CONSENT_FETCH_PATH=/api/hiecm/consent/v3/fetch
ABDM_M3_HEALTH_INFO_REQUEST_PATH=/api/hiecm/data-flow/v3/health-information/request
ABDM_M3_HEALTH_INFO_CM_NOTIFY_PATH=/api/hiecm/data-flow/v3/health-information/notify
ABDM_M3_LINK_TOKEN_INIT_PATH=/gateway/v0.5/links/link/token/init
ABDM_M3_LINK_TOKEN_CONFIRM_PATH=/gateway/v0.5/links/link/token/confirm
ABDM_M3_LINK_CONTEXT_NOTIFY_PATH=/gateway/v0.5/links/context/notify
ABDM_M3_PATIENT_PROFILE_SHARE_PATH=/gateway/v0.5/patients/profile/share

# NABIDH
NABIDH_BASE_URL=https://api.nabidh.ae
NABIDH_AUTH_PATH=/oauth2/token
NABIDH_CLIENT_ID=
NABIDH_CLIENT_SECRET=
NABIDH_SCOPE=
NABIDH_GRANT_TYPE=client_credentials
NABIDH_HTTP_TIMEOUT_SECONDS=15
NABIDH_TOKEN_REFRESH_SKEW_SECONDS=120
NABIDH_FHIR_BASE_PATH=/fhir

# Gateway orchestration defaults
ABDM_BRIDGE_URL=https://your-public-url.ngrok-free.dev
GATEWAY_DEFAULT_DATA_PUSH_URL=https://your-public-url.ngrok-free.dev/api/v1/health-information/data
ORCHESTRATION_REDIS_URL=
ORCHESTRATION_STATE_TTL_SECONDS=86400
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=gateway
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
ABDM_LINKED_CARE_CONTEXTS_COLLECTION=linked_care_contexts
ABDM_CONSENTS_COLLECTION=abdm_consents
ABDM_LINKAGE_MONGO_ENABLED=true
